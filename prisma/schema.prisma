generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id             Int        @id @default(autoincrement())
  email          String     @unique
  /// Written from firstName and lastName by fullName(); the display name
  /// everything else reads. Kept as its own column so that no read site has
  /// to know how the two parts join.
  name           String
  firstName      String     @default("")
  lastName       String     @default("")
  password       String
  admin          Boolean    @default(false)
  /// Sealed into the session cookie at sign-in and compared on every request.
  /// Raising it ends every session this person has: a password change or
  /// reset, a demotion, "sign out everywhere". The cookie is stateless, so
  /// without this a stolen or left-behind one stayed valid for its full
  /// fourteen days whatever happened to the account.
  sessionVersion Int        @default(0)
  /// Set once the address has been confirmed by following a mailed link.
  /// Null means unconfirmed, which is allowed — registration is by invitation,
  /// so the address is an identifier before it is a credential. It only
  /// becomes a credential when a password can be reset through it.
  emailVerifiedAt DateTime?
  /// A new address somebody asked to move to, not yet confirmed. It becomes
  /// `email` only when the link mailed to it is followed, so a typo never
  /// takes the account's address away — sign-in and "forgot password" keep
  /// using the old one until then.
  pendingEmail   String?
  passkeys       Passkey[]

  /// A round picture beside this person's contributions.
  ///
  /// Not in any backup, because accounts are not: an archive restored into a
  /// fresh installation makes new accounts, and a URL pointing at a file that
  /// belonged to the old one would be a broken picture with somebody else's
  /// face missing from it.
  ///
  /// It *is* in scripts/sweep-blobs.mjs, and that is the part that matters.
  /// The sweep deletes every file in the store that no row points at, so a
  /// picture column it does not know about is a picture column whose files are
  /// deleted on the next run — silently, and a week later.
  avatarUrl      String?

  tokens         AuthToken[]
  shoppingList   ShoppingList?
  posts          Post[]
  cookEntries    CookEntry[]
  tickets        Ticket[]
  ratings        Rating[]
  favorites      Favorite[]
  invitesCreated Invite[]   @relation("InviteCreatedBy")
  invitesUsed    Invite[]   @relation("InviteUsedBy")
}

/// A single-use registration link.
///
/// Registration is invite-only: this is a personal cookbook, and an open
/// sign-up form on the public internet collects nothing but spam accounts.
///
/// Codes are stored as written rather than hashed, so an admin can copy a link
/// again later. They are 128 bits of randomness, single use, and expire; a
/// database leak already exposes password hashes, so this is not the weak link.
model Invite {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  /// Free text for the admin: who it was meant for.
  note        String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  createdById Int
  createdBy   User      @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  usedAt      DateTime?
  usedById    Int?
  usedBy      User?     @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([expiresAt])
}

/// A single-use token sent to an address: a password reset or an address
/// confirmation. Only the hash is stored — for the minutes it lives, a reset
/// token is as good as the password, and hashing passwords while keeping a
/// live skeleton key in the next table would be strange.
model AuthToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  /// reset | verify
  purpose   String
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId, purpose])
  @@index([expiresAt])
}

/// The inbox. Everything shared from a phone lands here raw, before anyone
/// decides whether it becomes a recipe. See src/lib/capture.ts for why the
/// collecting, the parsing and the deciding are kept apart.
model Capture {
  id     Int     @id @default(autoincrement())
  /// url | text | image
  kind   String
  /// youtube | instagram | tiktok | web | note | photo
  source String

  sourceUrl String?
  /// Whatever was shared, kept verbatim so a capture survives a parser that
  /// cannot yet read it and can be retried once the parser improves.
  rawText   String?
  imageUrl  String?
  /// What the sender typed alongside the share.
  note      String?

  /// new | ready | needsWork | failed | published
  /// rules | rules+ai | ai — how this draft came to exist.
  ///
  /// A draft produced by rules is a transcription of what a page said; a draft
  /// produced by a model is a *reading* of it, and the second can be
  /// confidently wrong in ways the first cannot. Somebody deciding how
  /// carefully to check a draft before publishing is entitled to know which
  /// they are looking at.
  ///
  /// Null on every row written before this existed, and shown as nothing
  /// rather than as a guess.
  readBy     String?
  /// Which provider answered, when one did.
  aiProvider String?

  status String  @default("new")
  error  String?
  /// The parsed recipe draft, in the shape the recipe form expects.
  draft  Json?

  recipe   Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  recipeId Int?

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status, createdAt])

  /// Postgres does not index the referencing side of a foreign key, so
  /// deleting a recipe scanned this table to find the captures pointing at it.
  @@index([recipeId])
}

/// A long-lived key that lets one device — an iOS Shortcut, a mail bridge —
/// post to the capture endpoint. Only the hash is stored.
model CaptureToken {
  id         Int       @id @default(autoincrement())
  label      String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
}

/// Something that went wrong, grouped so that two hundred occurrences of one
/// bug are one row with a count. See src/lib/errorReport.ts for why this is in
/// the database rather than in a monitoring service.
model ErrorLog {
  id          Int      @id @default(autoincrement())
  /// Same problem, same fingerprint.
  fingerprint String   @unique
  /// client | server
  source      String
  message     String
  stack       String?
  /// The path it happened on, without the query string.
  path        String?
  count       Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  /// Set when it has been dealt with; the list hides these.
  resolvedAt  DateTime?
  /// Screenshots the admin attached to show what it looked like.
  photos      ReportPhoto[]

  @@index([resolvedAt, lastSeenAt])
}

/// A written entry.
///
/// One model for two things that turned out to be the same thing written on
/// different days: an entry with no recipe is an ordinary post, and an entry
/// attached to a recipe is a dated note on that recipe's page — "made it again
/// with half the sugar, better". Keeping them apart would have meant two
/// tables, two editors and two lists, for a difference of one nullable column.
///
/// Writing a post never requires a recipe, and never requires the AI import
/// either: it is a title and some Markdown.
model Post {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  /// Markdown, same as a recipe's method.
  body        String
  imageUrl    String?

  /// Null while it is a draft. A draft is visible to its author in the admin
  /// area and nowhere else.
  publishedAt DateTime?

  /// Whether this entry's own address answers without a session.
  ///
  /// A different question from `publishedAt`, which says whether the entry is
  /// finished and shows in the blog at all. This one is the third stage of
  /// sharing: private, secret link, open web.
  isPublic    Boolean   @default(false)

  /// The recipes and collections this entry is about, in the order they
  /// were listed. An entry used to belong to at most one recipe; writing about
  /// a week of cooking, or introducing a collection, needed more than that.
  /// Deleting a recipe or a collection removes the link, never the entry.
  recipes     PostRecipe[]
  collections PostCollection[]

  authorId    Int?
  author      User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  /// The public link, exactly as on a recipe. See Recipe.shareToken.
  shareToken  String?   @unique

  /// Search columns, the same shape as a recipe's. Written by searchFields()
  /// in src/lib/searchText.ts, never by hand.
  searchTitle String    @default("")
  searchBody  String    @default("")
  searchVector Unsupported("tsvector")?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([publishedAt])
  @@index([isPublic])
}

/// A photograph of the dish as somebody actually cooked it.
///
/// Separate from Image, which is the recipe's own photography and belongs to
/// whoever wrote it. This is the other thing a cookbook is for: proof that a
/// recipe has been made, by people who are not the author, and what it looked
/// like when they did.
///
/// Cascade on the recipe, unlike Post, and the difference is deliberate: a
/// written entry stands on its own once its recipe is gone, while a picture of
/// a dish with no dish attached has nowhere to be shown and nothing to say.
/// SetNull on the user, so deleting an account keeps the pictures it left.
/// "I cooked this" — once, by one person, with what they would change and
/// whatever they photographed.
///
/// This was two tables, and the note in the old one said, without apparent
/// irony, "two ideas that turned out to be one" — about the date and the note,
/// while keeping the photograph apart on the grounds that "a photograph is a
/// thing you took and this is a thing that happened".
///
/// That distinction does not survive contact with the page. A photograph of a
/// finished dish *is* the thing that happened; it is the evidence, not a
/// separate event. Keeping them apart bought two headings, two buttons, two
/// lists and two permission rules for one act, and the cost landed on whoever
/// was reading the recipe and could not tell what either section was for.
///
/// So: one entry per cooking. The note is optional and added afterwards, the
/// photographs are optional and added afterwards, and recording the fact is
/// one tap with nothing in front of it — because the fact is the part that
/// otherwise does not get recorded.
model CookEntry {
  id        Int      @id @default(autoincrement())

  recipeId  Int
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  /// Nullable, and set to null rather than cascading when an account goes.
  ///
  /// CookLog used to cascade, on the grounds that a note about what to change
  /// next time was private to its author. It never was — every account reads
  /// every entry, notes included — and that false premise was quietly deleting
  /// real contributions from a shared page. An entry is a contribution, like
  /// the photograph always was, and it outlives the account as "Someone".
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  cookedAt  DateTime @default(now())

  /// Short on purpose. A paragraph about a recipe is an entry on the blog.
  note      String?

  photos    CookEntryPhoto[]

  /// "When was this last cooked", newest first — and the home page's
  /// "not made in a while" order.
  @@index([recipeId, cookedAt])

  /// One person's own cooking, newest first; also what stops a deleted account
  /// from scanning the whole table to null its rows.
  @@index([userId, cookedAt])
}

/// A picture belonging to one entry.
///
/// Its own table rather than a column, because one evening produces three
/// photographs as readily as one, and a url column would have forced those
/// three to be three separate evenings — which is the duplication this whole
/// merge exists to remove.
model CookEntryPhoto {
  id        Int       @id @default(autoincrement())
  url       String

  /// The order somebody arranged them in, not the order they uploaded.
  position  Int       @default(0)

  entryId   Int
  entry     CookEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())

  @@index([entryId, position])
}

model Recipe {
  id           Int        @id @default(autoincrement())
  title        String
  slug         String     @unique
  /// Free words, lower case, plus the diet tags "vegetarian" and "vegan".
  /// See lib/tags.ts.
  tags         String[]   @default([])
  description  String?
  instructions String     // Markdown content
  views        Int        @default(0)
  nationality  String?
  category     String?
  servings     Int?
  prepMinutes  Int?
  cookMinutes  Int?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  /// Whether this recipe's own address works for somebody with no account.
  ///
  /// Different from shareToken, and both are worth having. A share token is a
  /// secret URL for one person, withdrawable, and says "do not index me". This
  /// is the recipe's real address working for everyone: a link you can put in
  /// a message without it looking like a password, and a page a search engine
  /// may keep.
  ///
  /// Public covers the recipe — its ingredients, its method, its picture and
  /// the average rating. It does **not** cover the cooking entries: rating,
  /// noting and photographing still need an account, and who cooked what, when
  /// and with what note is not shown to anybody without one. Names and
  /// photographs of the people in a household are not part of publishing a
  /// recipe, and once they are on the open web they are not retrievable.
  ///
  /// Default false, which is the only safe default: a recipe added next month
  /// is private until somebody decides otherwise, rather than public until
  /// somebody notices.
  isPublic     Boolean    @default(false)

  /// Imported and tidied up, but not yet one of this cookbook's own recipes.
  ///
  /// The state between the inbox — where quality varies wildly — and a recipe
  /// somebody stands behind. A draft is meant to be cooked once and adjusted
  /// before it counts, and until it does it is deliberately not offered
  /// anywhere: not in the list, not in search, not as a suggestion, never in
  /// public, and no post can be written about it.
  ///
  /// One-way on purpose. A recipe can be finished; it cannot be sent back to
  /// being a draft. The reverse would mean a recipe that was public yesterday
  /// having to un-publish itself, revoke its share link and disappear from
  /// collections other people can see — a lot of machinery for an act nobody
  /// asked for. Making one again from the source is the honest alternative.
  isDraft      Boolean    @default(false)

  /// The public link, or null when the recipe is only for people who are
  /// logged in. Unguessable rather than a flag on the normal address: a secret
  /// URL can be handed to one person and withdrawn again without renaming the
  /// recipe, and revoking is setting this back to null.
  shareToken   String?    @unique

  /// Search columns. Written by searchFields() in src/lib/searchText.ts, never
  /// by hand: they hold the recipe's own wording plus an ae/oe/ue spelling of
  /// every word with an umlaut, so "Kaesespaetzle" finds "Käsespätzle".
  searchTitle  String     @default("")
  searchBody   String     @default("")

  /// Maintained by Postgres from the two columns above. Prisma has no tsvector
  /// type, so it is declared Unsupported and queried through raw SQL; nothing
  /// writes to it.
  searchVector Unsupported("tsvector")?

  images         Image[]
  ratings        Rating[]
  favorites      Favorite[]
  ingredients    Ingredient[]
  captures       Capture[]
  menuItems      MenuItem[]
  revisions      RecipeRevision[]
  posts          PostRecipe[]
  cookEntries    CookEntry[]
  collections    CollectionRecipe[]

  /// This table had no index at all beyond the two unique columns and the
  /// search vector, while being the table everything sorts and groups by.
  ///
  /// `createdAt` is the default order of the whole site — the front page, the
  /// admin list, the export, the backup — so every visit sorted the table.
  /// `views` is the "popular" order. `category` and `nationality` are grouped
  /// on *unconditionally* on every front-page render, to build the filter
  /// rails, whether or not anybody filtered: two full scans guaranteed, per
  /// request, forever.
  @@index([createdAt])
  @@index([views])
  @@index([category])
  @@index([nationality])
}

/// One ingredient line, split into the parts a cook actually uses.
///
/// `raw` keeps exactly what the author typed, so nothing is lost when the
/// parser reads a line differently than intended; the structured columns are
/// what make scaling, a shopping list and searching by ingredient possible.
model Ingredient {
  id          Int     @id @default(autoincrement())
  recipeId    Int
  recipe      Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  position    Int
  /// 200 for "200 g"; 0.5 for "1/2"; null for "Salz"
  quantity    Float?
  /// Upper bound of a range: "2-3 EL" is quantity 2, quantityMax 3
  quantityMax Float?
  /// "g", "EL", "cups" — null when the line has no unit
  unit        String?
  /// The ingredient itself, without quantity or unit
  name        String
  /// Exactly what the author typed in the amount field
  raw         String  @default("")
  /// The heading this ingredient is listed under ("Für den Teig"), or null
  /// for a recipe with one list. Ingredients of one section are consecutive.
  section     String?

  @@unique([recipeId, position])

  /// A B-tree on the name, for exact and prefix lookups.
  ///
  /// It cannot serve "what can I make with what I have", which asks
  /// `ILIKE '%zwiebel%'` — a pattern starting with a wildcard. That needs a
  /// trigram index, which Prisma has no syntax for, so it is created in
  /// migration 0012 and lives only there. Measured: sequential scan of 32,000
  /// rows before, bitmap index scan after.
  @@index([name])
}

model Image {
  id  Int    @id @default(autoincrement())
  url String
  /// The order the author arranged them in. Reading by id instead would
  /// reshuffle a gallery every time one picture was replaced.
  position Int @default(0)

  recipeId Int
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId, position])
}

model Rating {
  id        Int      @id @default(autoincrement())
  value     Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId  Int
  createdAt DateTime @default(now())

  @@unique([userId, recipeId])

  /// The unique index above leads with userId, so it cannot serve a lookup by
  /// recipe — and every rating-sorted page, every average, and the cascade
  /// behind every recipe deletion is a lookup by recipe.
  @@index([recipeId])
}

model Favorite {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId  Int
  createdAt DateTime @default(now())

  @@unique([userId, recipeId])

  /// Same reason as Rating: deleting a recipe cascades through this table, and
  /// without recipeId leading, that is a sequential scan every time.
  @@index([recipeId])
}

/// One window of one rate limit.
///
/// The limiter used to be a Map inside the process. On Vercel a process is one
/// warm instance among however many the platform started, so "ten attempts per
/// fifteen minutes" meant ten times the number of instances, and a cold start
/// reset it to zero — which is no limit on password guessing at all.
///
/// A row, incremented by the same statement that reads it, so every instance
/// counts into the same window. Used for the things where the limit is a
/// security property; the view counter keeps the in-process one, because a
/// database write to ration a database write is a strange trade.
model RateLimit {
  /// What is being limited, and for whom: "login:203.0.113.4".
  key       String   @id
  count     Int      @default(0)
  /// When this window closes. Rows past it are reused in place, and swept.
  expiresAt DateTime

  @@index([expiresAt])
}

/// One thing to fix, change or add.
///
/// Called a ticket rather than "feedback" on purpose: feedback is something
/// you receive, a ticket is something you work through, and a list named for
/// the first is read while a list named for the second is emptied.
///
/// Its own table rather than an e-mail, because an e-mail about a cookbook
/// arrives in the same inbox as everything else and is answered never. A list
/// that lives in the admin area is a list somebody opens.
///
/// **Not in the archive**, and that is a decision rather than an oversight:
/// this is writing about *this deployment of the tool*, not about the
/// cookbook. "The search is slow" restored into a fresh installation is a
/// sentence with no referent. The same reasoning exempts the capture inbox and
/// the error log; scripts/check-backup.mjs holds all three with their reasons.
model Ticket {
  id         Int       @id @default(autoincrement())

  /// idea | problem | other. A short vocabulary rather than free text, so the
  /// list can be read at a glance, and only three of them because a chooser
  /// with eight options is a form.
  kind       String

  body       String

  /// Where they were when they wrote it, as a path. Sent by the page rather
  /// than guessed from a header, and worth more than any amount of "on the
  /// recipe screen, I think" — it is the difference between reproducing a
  /// problem and asking about it.
  path       String?

  /// Who wrote it. Nulled rather than cascaded when an account goes: the
  /// sentence stays useful without the name, and deleting somebody's account
  /// should not delete the reason the tool got better.
  userId     Int?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Screenshots sent with it.
  photos     ReportPhoto[]

  createdAt  DateTime  @default(now())

  /// Set when it has been dealt with; the list hides these by default, the
  /// same way the error log does.
  resolvedAt DateTime?

  @@index([resolvedAt, createdAt])
  @@index([userId])
}

/// A handful of recipes with a name on it: "Weihnachten", "Schnell nach der
/// Arbeit", "Für Tante Elfi".
///
/// Not a second category system. A category says what a dish *is* and there is
/// one right answer; a collection says what a group of dishes is *for*, and a
/// recipe belongs to as many as somebody finds useful. That is the whole reason
/// this is a separate table rather than another column.
///
/// Shareable by the same token as a single recipe, and revoked the same way —
/// which is most of why it is worth building: "here is the Christmas menu" is a
/// thing people actually want to send.
model Collection {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  /// Shown under the title. Markdown, as long as it needs to be; the first
  /// paragraph is what a tile shows.
  description String?
  /// The collection's own picture, uploaded to our store. Without one, the
  /// first recipe's picture stands in.
  imageUrl    String?

  /// Whether this collection's own address answers without a session.
  /// The third stage of sharing, as on a recipe and an entry.
  isPublic    Boolean  @default(false)

  /// The public link, or null. Same mechanism as a recipe's, deliberately:
  /// one way of making something public is one way of taking it back.
  shareToken  String?  @unique

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recipes     CollectionRecipe[]
  posts       PostCollection[]

  @@index([createdAt])
  @@index([isPublic])
}

/// One recipe in one collection, in the order somebody arranged.
///
/// A join table with a position, not an implicit many-to-many: the order of a
/// menu is the point of a menu, and an implicit relation has no room to keep it.
model CollectionRecipe {
  collectionId Int
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  recipeId     Int
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  position     Int

  @@id([collectionId, recipeId])
  @@index([collectionId, position])
  /// Deleting a recipe cascades through here; without this that is a scan.
  @@index([recipeId])
}

/// An API key for one AI provider, kept where it can be changed.
///
/// It used to live in `ANTHROPIC_API_KEY` on Vercel, which is the right place
/// for a secret and the wrong place for a setting somebody wants to try out:
/// changing it meant opening a dashboard, editing an environment variable and
/// waiting for a redeploy, and the only way to find out whether the key worked
/// was to import a recipe and see. So it lives here, and the admin screen has
/// a button that asks the provider whether the key is good.
///
/// **`secret` is a sealed envelope, never the key.** AES-256-GCM under a key
/// derived from the session secret — see `src/lib/secretBox.ts`. A database
/// dump, a backup, a support session with somebody reading rows: none of them
/// hand over a working key. `hint` is the last four characters, which is all
/// the screen needs to say *which* key this is.
///
/// The environment variables still work and still win nothing: a provider
/// configured in the environment is shown on the screen as coming from there
/// and cannot be edited, so there is never a question about which key is
/// actually being used.
model AiCredential {
  /// anthropic | openai | google. The provider *is* the identity: one key per
  /// provider, and an upsert rather than a second row nobody meant to make.
  provider   String    @id

  secret     String
  hint       String

  /// Overrides the provider's default model. Null means the default, which is
  /// the only sensible behaviour when model names change faster than releases.
  model      String?

  enabled    Boolean   @default(true)

  /// Ascending, and it is the fallback order: the first enabled provider is
  /// asked, and the next one only if that call fails. Zero is "primary".
  priority   Int       @default(10)

  /// What the last "test" button said. Kept because the useful question is not
  /// whether a key is set but whether it worked, and the answer is worth more
  /// than the moment it was asked.
  checkedAt  DateTime?
  checkError String?

  /// Set when `model` was filled in by the fallback rather than by a person.
  ///
  /// The screen says so, because "the model changed itself" is exactly the
  /// kind of thing that should never be a surprise — and because the reason it
  /// changed (the previous one was out of quota) is worth knowing.
  autoModelAt DateTime?

  /// When this key was last seen to actually work — and the gate on using it.
  ///
  /// A key that has never produced a recipe is not used for anything. Pasting
  /// one in is not evidence: a key with no credit, a key for the wrong
  /// product, a key with a typo in it all authenticate or fail in ways nobody
  /// sees until a share from a supermarket comes back empty.
  ///
  /// Only ever *set* on a success, and cleared only when the key itself is
  /// replaced. A later failure records itself in `checkError` and leaves this
  /// alone, because the failure that prompted this design was a 503 saying
  /// "spikes in demand are usually temporary" — and a gate that switches the
  /// feature off on a transient error is a gate somebody has to remember to
  /// re-open.
  verifiedAt DateTime?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([enabled, priority])
}

/// Settings of this deployment that are not secrets and not worth a column.
///
/// Exactly one key so far — `ai.assist`, which decides whether the AI is asked
/// at all — and the table exists rather than a column somewhere because the
/// next such setting should not need a migration to be born.
///
/// Not a place for anything a person wrote. A row here is a knob.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// What we have learned about how one website lays out a recipe.
///
/// Written the first time a model reads a page from this host and can say
/// where it found things; read on every later import from that host, which
/// then needs no model at all. That is the point of the table: a key stops
/// being something the import depends on and becomes something that makes the
/// cookbook permanently better.
///
/// A row is never written on a model's say-so. The profile is applied to the
/// page it was learned from and compared with what the model itself extracted;
/// one that cannot reproduce that answer is discarded and never reaches here.
/// See `lib/siteLearn.ts`.
///
/// Nothing secret lives in this table. It holds heading texts and meta tag
/// names — facts about a public web page.
model SiteProfile {
  /// The hostname, lowercased and without `www.`, so that
  /// `www.example.com/recipes/x` and `example.com/x` share what was learned.
  host        String   @id

  /// The strategies, validated against `profileSchema` before being written
  /// and again after being read. Stored as text rather than Json because it is
  /// only ever handled as a whole and this keeps the Prisma client's typing
  /// out of the way of a zod schema that is already the source of truth.
  profile     String

  /// The page it was learned from, and by which model. Both are for the
  /// person reading this table later and wondering whether to trust a row.
  learnedFrom String
  learnedBy   String
  learnedAt   DateTime @default(now())

  /// When it was last used successfully. A profile nobody has used in a year
  /// is a candidate for re-learning even if it has never failed.
  usedAt      DateTime?

  /// Consecutive imports where the profile produced a draft the scoring
  /// refused. Reset to zero on every success, because a site that returns a
  /// bad page once is not a site that has been redesigned.
  failures    Int      @default(0)

  /// Set once `failures` passes the threshold. A stale profile is not deleted
  /// — the next import re-learns and overwrites it, and until then the row is
  /// the record of what the site used to look like.
  stale       Boolean  @default(false)

  /// Why it was last refused, for the diagnose script and for anyone asking
  /// why a site suddenly costs a model call again.
  lastError   String?

  updatedAt   DateTime @updatedAt

  @@index([stale, usedAt])
}

/// A recipe an entry is about. See `Post.recipes`.
model PostRecipe {
  postId   Int
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  recipeId Int
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  position Int

  @@id([postId, recipeId])
  @@index([recipeId])
}

/// A collection an entry is about. See `Post.collections`.
model PostCollection {
  postId       Int
  post         Post       @relation(fields: [postId], references: [id], onDelete: Cascade)

  collectionId Int
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  position     Int

  @@id([postId, collectionId])
  @@index([collectionId])
}

/// One shopping list per person. Recipes and collections are added to it at
/// the servings they were being read at; the same ingredient from several
/// recipes becomes one line. See lib/shopping.ts.
model ShoppingList {
  id         Int            @id @default(autoincrement())
  userId     Int            @unique
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// A link that lets somebody without an account see the list and tick
  /// things off — the person who is actually in the shop. Null when not shared.
  shareToken String?        @unique

  items      ShoppingItem[]
  updatedAt  DateTime       @updatedAt
}

model ShoppingItem {
  id         Int          @id @default(autoincrement())
  listId     Int
  list       ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)

  /// As it is shown: "Zwiebeln".
  name       String
  /// What lines are merged on: the name folded to lower case and singular.
  key        String
  /// 'mass' (g), 'volume' (ml), 'spoon' (ml), 'count:<unit>', or null for an
  /// ingredient with no amount ("Salz"). Lines only merge when this matches.
  measure    String?
  amount     Float?
  /// Which shelf it is on, for grouping. See lib/shopping.ts.
  aisle      String
  /// The recipes it is for, as titles — shown under the line.
  sources    String[]     @default([])
  checked    Boolean      @default(false)
  createdAt  DateTime     @default(now())

  @@index([listId, checked])
}

/// How a recipe was before an edit: every save keeps the version it
/// replaces, so a change can be looked at and undone. The text, the numbers,
/// the ingredients and the tags; not the pictures, whose files an edit
/// deletes. See lib/revisions.ts.
model RecipeRevision {
  id        Int      @id @default(autoincrement())
  recipeId  Int
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  snapshot  Json
  /// Who made the edit that replaced it, by name at the time.
  editedBy  String?
  createdAt DateTime @default(now())

  @@index([recipeId, createdAt])
}

/// A menu for an evening: courses in order, each with its dishes, printed as
/// a card in one of three styles. Not a collection — a collection is a list
/// of recipes, a menu is an evening. See lib/menu.ts.
model Menu {
  id         Int        @id @default(autoincrement())
  title      String
  slug       String     @unique
  /// "Weihnachten 2026", "Annas Geburtstag". Shown on the card.
  occasion   String?
  date       DateTime?
  /// What the shopping list scales every recipe to.
  guests     Int?
  /// 'casual', 'chic' or 'festive'. See MENU_STYLES in lib/menu.ts.
  style      String     @default("casual")
  /// A line or two of welcome, under the title.
  intro      String?
  /// A link that shows the card without an account. Null when not shared.
  shareToken String?    @unique
  items      MenuItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([date])
}

/// One dish on a menu. The course is its name ("Vorspeise"); dishes of one
/// course are consecutive, in `position` order.
model MenuItem {
  id          Int     @id @default(autoincrement())
  menuId      Int
  menu        Menu    @relation(fields: [menuId], references: [id], onDelete: Cascade)
  position    Int
  course      String
  /// The recipe, when the dish is one of ours. A deleted recipe leaves the
  /// dish on the menu under its written name.
  recipeId    Int?
  recipe      Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  /// As the card says it. Filled from the recipe when one is chosen.
  title       String
  /// One line under it: "mit geröstetem Kürbiskernöl".
  description String?

  @@index([menuId, position])
  @@index([recipeId])
}


/// A device that may sign in to an account without a password: the public
/// half of a key pair whose private half never leaves the phone, the laptop
/// or the password manager. Nothing here is a secret.
///
/// Not in any backup, for the same reason accounts are not: a restore makes
/// new accounts, and a passkey belongs to the installation it was made for.
model Passkey {
  id           Int       @id @default(autoincrement())
  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// base64url, as the browser reports it.
  credentialId String    @unique
  publicKey    Bytes
  /// The authenticator's signature counter; most passkeys keep it at 0.
  counter      Int       @default(0)
  transports   String[]  @default([])
  /// "iPhone · Safari", from the browser that made it — how the list tells them apart.
  name         String
  /// Synced (iCloud Keychain, 1Password) rather than bound to one device.
  backedUp     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

/// Something the admin handed over for fixing: an inbox row, an error or a
/// ticket, as an anonymized snapshot (lib/workItems.ts). Listed publicly at
/// /api/work while open. Not in any backup: it is a to-do list about this
/// installation, and every snapshot can be made again from its source.
model WorkItem {
  id        Int       @id @default(autoincrement())
  /// capture | error | ticket
  kind      String
  /// The id of the row it was made from — not a relation, because the
  /// snapshot outlives the row.
  refId     Int
  /// What the admin wants looked at, in their words.
  note      String?
  data      Json
  createdAt DateTime  @default(now())
  closedAt  DateTime?
  /// Why it closed: done | resolved | published | ready | removed.
  closedReason String?
  /// Added by the application (an obvious failure), not by the admin.
  auto      Boolean   @default(false)
  /// Taken off the list by the admin. Kept rather than deleted, so an
  /// automatic item that was not wanted does not come straight back.
  dismissedAt DateTime?
  /// The admin chose to publish the item's photos with it. Off by default:
  /// a screenshot can show more than its sender meant to.
  withPhotos Boolean   @default(false)

  @@unique([kind, refId])
  @@index([closedAt, createdAt])
}

/// A photo sent with a ticket, or attached by the admin to an error: what
/// the page looked like when it went wrong. In the Blob store under an
/// unguessable name; not in any backup, like the tickets and errors
/// themselves.
model ReportPhoto {
  id         Int       @id @default(autoincrement())
  url        String
  ticketId   Int?
  ticket     Ticket?   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  errorLogId Int?
  errorLog   ErrorLog? @relation(fields: [errorLogId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@index([ticketId])
  @@index([errorLogId])
}
