generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id             Int        @id @default(autoincrement())
  email          String     @unique
  /// Written from firstName and lastName by fullName(); the display name
  /// everything else reads. Kept as its own column so that no read site has
  /// to know how the two parts join.
  name           String
  firstName      String     @default("")
  lastName       String     @default("")
  password       String
  admin          Boolean    @default(false)
  /// Set once the address has been confirmed by following a mailed link.
  /// Null means unconfirmed, which is allowed — registration is by invitation,
  /// so the address is an identifier before it is a credential. It only
  /// becomes a credential when a password can be reset through it.
  emailVerifiedAt DateTime?

  tokens         AuthToken[]
  ratings        Rating[]
  favorites      Favorite[]
  invitesCreated Invite[]   @relation("InviteCreatedBy")
  invitesUsed    Invite[]   @relation("InviteUsedBy")
}

/// A single-use registration link.
///
/// Registration is invite-only: this is a personal cookbook, and an open
/// sign-up form on the public internet collects nothing but spam accounts.
///
/// Codes are stored as written rather than hashed, so an admin can copy a link
/// again later. They are 128 bits of randomness, single use, and expire; a
/// database leak already exposes password hashes, so this is not the weak link.
model Invite {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  /// Free text for the admin: who it was meant for.
  note        String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  createdById Int
  createdBy   User      @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  usedAt      DateTime?
  usedById    Int?
  usedBy      User?     @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([expiresAt])
}

/// A single-use token sent to an address: a password reset or an address
/// confirmation. Only the hash is stored — for the minutes it lives, a reset
/// token is as good as the password, and hashing passwords while keeping a
/// live skeleton key in the next table would be strange.
model AuthToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  /// reset | verify
  purpose   String
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId, purpose])
  @@index([expiresAt])
}

/// The inbox. Everything shared from a phone lands here raw, before anyone
/// decides whether it becomes a recipe. See src/lib/capture.ts for why the
/// collecting, the parsing and the deciding are kept apart.
model Capture {
  id     Int     @id @default(autoincrement())
  /// url | text | image
  kind   String
  /// youtube | instagram | tiktok | web | note | photo
  source String

  sourceUrl String?
  /// Whatever was shared, kept verbatim so a capture survives a parser that
  /// cannot yet read it and can be retried once the parser improves.
  rawText   String?
  imageUrl  String?
  /// What the sender typed alongside the share.
  note      String?

  /// new | ready | needsWork | failed | published
  status String  @default("new")
  error  String?
  /// The parsed recipe draft, in the shape the recipe form expects.
  draft  Json?

  recipe   Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  recipeId Int?

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status, createdAt])
}

/// A long-lived key that lets one device — an iOS Shortcut, a mail bridge —
/// post to the capture endpoint. Only the hash is stored.
model CaptureToken {
  id         Int       @id @default(autoincrement())
  label      String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
}

/// Something that went wrong, grouped so that two hundred occurrences of one
/// bug are one row with a count. See src/lib/errorReport.ts for why this is in
/// the database rather than in a monitoring service.
model ErrorLog {
  id          Int      @id @default(autoincrement())
  /// Same problem, same fingerprint.
  fingerprint String   @unique
  /// client | server
  source      String
  message     String
  stack       String?
  /// The path it happened on, without the query string.
  path        String?
  count       Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  /// Set when it has been dealt with; the list hides these.
  resolvedAt  DateTime?

  @@index([resolvedAt, lastSeenAt])
}

model Recipe {
  id           Int        @id @default(autoincrement())
  title        String
  slug         String     @unique
  description  String?
  instructions String     // Markdown content
  views        Int        @default(0)
  nationality  String?
  category     String?
  servings     Int?
  prepMinutes  Int?
  cookMinutes  Int?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  /// The public link, or null when the recipe is only for people who are
  /// logged in. Unguessable rather than a flag on the normal address: a secret
  /// URL can be handed to one person and withdrawn again without renaming the
  /// recipe, and revoking is setting this back to null.
  shareToken   String?    @unique

  /// Search columns. Written by searchFields() in src/lib/searchText.ts, never
  /// by hand: they hold the recipe's own wording plus an ae/oe/ue spelling of
  /// every word with an umlaut, so "Kaesespaetzle" finds "Käsespätzle".
  searchTitle  String     @default("")
  searchBody   String     @default("")

  /// Maintained by Postgres from the two columns above. Prisma has no tsvector
  /// type, so it is declared Unsupported and queried through raw SQL; nothing
  /// writes to it.
  searchVector Unsupported("tsvector")?

  images         Image[]
  ratings        Rating[]
  favorites      Favorite[]
  ingredients    Ingredient[]
  captures       Capture[]
}

/// One ingredient line, split into the parts a cook actually uses.
///
/// `raw` keeps exactly what the author typed, so nothing is lost when the
/// parser reads a line differently than intended; the structured columns are
/// what make scaling, a shopping list and searching by ingredient possible.
model Ingredient {
  id          Int     @id @default(autoincrement())
  recipeId    Int
  recipe      Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  position    Int
  /// 200 for "200 g"; 0.5 for "1/2"; null for "Salz"
  quantity    Float?
  /// Upper bound of a range: "2-3 EL" is quantity 2, quantityMax 3
  quantityMax Float?
  /// "g", "EL", "cups" — null when the line has no unit
  unit        String?
  /// The ingredient itself, without quantity or unit
  name        String
  /// Exactly what the author typed in the amount field
  raw         String  @default("")

  @@unique([recipeId, position])
  @@index([name])
}

model Image {
  id  Int    @id @default(autoincrement())
  url String
  /// The order the author arranged them in. Reading by id instead would
  /// reshuffle a gallery every time one picture was replaced.
  position Int @default(0)

  recipeId Int
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId, position])
}

model Rating {
  id        Int      @id @default(autoincrement())
  value     Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId  Int
  createdAt DateTime @default(now())

  @@unique([userId, recipeId])
}

model Favorite {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId  Int
  createdAt DateTime @default(now())

  @@unique([userId, recipeId])
}
