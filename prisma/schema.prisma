generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  name      String
  password  String
  admin     Boolean    @default(false)
  ratings   Rating[]
  favorites Favorite[]
}

model Recipe {
  id           Int        @id @default(autoincrement())
  title        String
  slug         String     @unique
  description  String?
  instructions String     // Markdown content
  views        Int        @default(0)
  nationality  String?
  category     String?
  servings     Int?
  prepMinutes  Int?
  cookMinutes  Int?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  images         Image[]
  ratings        Rating[]
  favorites      Favorite[]
  ingredients    Ingredient[]
}

/// One ingredient line, split into the parts a cook actually uses.
///
/// `raw` keeps exactly what the author typed, so nothing is lost when the
/// parser reads a line differently than intended; the structured columns are
/// what make scaling, a shopping list and searching by ingredient possible.
model Ingredient {
  id          Int     @id @default(autoincrement())
  recipeId    Int
  recipe      Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  position    Int
  /// 200 for "200 g"; 0.5 for "1/2"; null for "Salz"
  quantity    Float?
  /// Upper bound of a range: "2-3 EL" is quantity 2, quantityMax 3
  quantityMax Float?
  /// "g", "EL", "cups" — null when the line has no unit
  unit        String?
  /// The ingredient itself, without quantity or unit
  name        String
  /// Exactly what the author typed in the amount field
  raw         String  @default("")

  @@unique([recipeId, position])
  @@index([name])
}

model Image {
  id       Int    @id @default(autoincrement())
  url      String
  recipeId Int
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model Rating {
  id        Int      @id @default(autoincrement())
  value     Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId  Int
  createdAt DateTime @default(now())

  @@unique([userId, recipeId])
}

model Favorite {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId  Int
  createdAt DateTime @default(now())

  @@unique([userId, recipeId])
}
