{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2021",
    "lib": ["ES2021", "DOM"],
    "noEmit": false,
    "types": ["node"]
  },
  // Only the suites. Pulling all of src/lib in here would drag the generated
  // Prisma client into every test run — megabytes of type definitions that
  // `npm run typecheck` already covers.
  "include": ["./**/*.ts"]
}
