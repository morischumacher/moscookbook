# Copy to .env.local for local development, and set the same variables in
# Vercel → Project → Settings → Environment Variables for production.

# --- Session ------------------------------------------------------------
# Secret used to encrypt the session cookie. MUST be at least 32 characters
# and MUST be set in production — the app refuses to serve requests without it.
# Generate one with:  openssl rand -base64 32
SECRET_COOKIE_PASSWORD=

# --- Database (Vercel Postgres) -----------------------------------------
# Both are provided automatically when you link a Vercel Postgres store.
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# --- Image storage (Vercel Blob) ----------------------------------------
# Provided automatically when you link a Vercel Blob store.
BLOB_READ_WRITE_TOKEN=

# --- Site address -------------------------------------------------------
# Base for canonical links and OpenGraph images. Optional on Vercel, which
# provides its own deployment URL; set this once you have a custom domain.
NEXT_PUBLIC_SITE_URL=

# --- Sending mail (Gmail) -----------------------------------------------
# Used for password-reset and address-confirmation messages. Without these the
# cookbook still works: sign-in, recipes and sharing are unaffected, only
# "forgot my password" has nothing to send.
#
# GMAIL_APP_PASSWORD is NOT the account password. Turn on 2-step verification
# on the Google account, then create an app password at
# https://myaccount.google.com/apppasswords and paste the 16 characters here
# (spaces are fine, Google shows it in groups of four).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional display name on the From line; defaults to mo'scookbook <GMAIL_USER>.
MAIL_FROM=

# --- Optional: AI recipe import -----------------------------------------
# When set, the admin form offers "photo of a cookbook page" and an AI option
# for pasted text. Everything works without it: pasting text and importing a
# URL are rule-based and need no key.
ANTHROPIC_API_KEY=
# Optional model override, defaults to claude-sonnet-5.
ANTHROPIC_MODEL=

# --- One-off admin bootstrap --------------------------------------------
# Only needed when running scripts/create-admin.js.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
