{
  "name": "cooking_webapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "create-admin": "node scripts/create-admin.js",
    "db:push": "prisma db push",
    "check:messages": "node scripts/check-messages.mjs",
    "check:search": "node scripts/check-search-writers.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:design": "node scripts/check-design.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:icons": "node scripts/check-icons.mjs",
    "check:blobs": "node scripts/check-blobs.mjs",
    "check:backup": "node scripts/check-backup.mjs",
    "fixtures": "node scripts/collect-import-fixtures.mjs",
    "mark:preview": "ts-node --transpile-only --project tests/tsconfig.json scripts/preview-mark.ts",
    "reindex": "ts-node --transpile-only --project tests/tsconfig.json scripts/reindex-search.ts",
    "verify:search": "ts-node --transpile-only --project tests/tsconfig.json scripts/verify-search.ts",
    "test": "ts-node --transpile-only --project tests/tsconfig.json tests/run.ts",
    "backup": "node scripts/backup.mjs",
    "sweep": "node scripts/sweep-blobs.mjs",
    "restore": "node scripts/restore.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/nodemailer": "^8.0.2",
    "@vercel/blob": "^2.3.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.3.1",
    "heic-convert": "^2.1.0",
    "iron-session": "^8.0.4",
    "next": "16.1.6",
    "next-intl": "^4.8.3",
    "nodemailer": "^10.0.10",
    "prisma": "^5.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.24",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}
